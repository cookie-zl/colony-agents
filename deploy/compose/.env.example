# 复制成 .env 再改：cp deploy/compose/.env.example deploy/compose/.env

# 必填：模型凭据。留空也能启动，但发起对话会缺凭证（可在 Web 的 Settings 里补）
DEEPSEEK_API_KEY=

# 镜像里烘的 dsh 版本
DSH_VERSION=0.2.1-rc.5
NPM_REGISTRY=https://registry.npmmirror.com
# 系统包源。官方 deb.debian.org 在部分网络下只有 ~1MB/min，装 git/curl 就要十几分钟。
# 出国网络优先 / 公司有内网 apt 源时改掉这里。
APT_MIRROR=mirrors.aliyun.com

# refresh 每次启动用镜像里的 profile 覆盖数据卷（线上语义）
# once    只在首次启动铺一次（本地想留住手装插件时用）
# off     完全不铺
DSH_PROFILE_SEED=refresh

# on  启用社区插件市场（应用内「插件 → 发现」）
# off 不加载市场插件，但用户可以继续手动装插件
DSH_MARKETPLACE=on

# 浏览器看到的地址。--public-url 只影响打印/上下文里的 URL，不放行访问；
# 真正放行的是 DSH_TRUSTED_HOST（不带端口的条目匹配任意端口）
DSH_PUBLIC_URL=http://dsh.localhost:8080/
DSH_TRUSTED_HOST=dsh.localhost

# read-only | workspace-write | danger-full-access
DSH_PERMISSION_MODE=workspace-write

# 容器内存上限
DSH_MEM_LIMIT=3g

# 挂进容器的工作目录（宿主路径，相对 deploy/compose/）
DSH_WORKSPACE=./workspace

# Caddy 入口端口
EDGE_PORT=8080

TZ=Asia/Shanghai

# 注意：不要在这里传宿主机的 HTTP_PROXY/HTTPS_PROXY。
# 宿主机上的 127.0.0.1 在容器里指向容器自己，代理会直接连不上。
# 真要借宿主机代理出网，用 host.docker.internal:
#   HTTP_PROXY=http://host.docker.internal:7890
# 并在 compose 的 dsh.environment 里显式加上这两行。
