# 依赖与产物
node_modules/
**/node_modules/
dist/
.dev/
*.tgz

# 本地配置与密钥：只提交 .env.example
.env
.env.*
!.env.example
deploy/compose/.env

# agent 的工作目录：里面是运行时产物，不进版本库（只留说明文件占位）
deploy/compose/workspace/*
